{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Foshowithit/ow-workbench/schemas/workflow.schema.json",
  "title": "ow-workbench workflow definition (Phase-1 hardened)",
  "type": "object",
  "required": [
    "initial_state",
    "objective",
    "inputs",
    "capabilities_tools",
    "environment",
    "constraints",
    "hidden_fixtures",
    "authority_boundary",
    "acceptance_contract",
    "independent_evaluation",
    "required_evidence",
    "terminal_outcome",
    "environment_identity",
    "environment_start_state_hash",
    "fixture_version",
    "fixture_content_hash",
    "evaluator_ref",
    "evaluator_version"
  ],
  "properties": {
    "initial_state": {"type": "object"},
    "objective": {"type": "string", "minLength": 1},
    "inputs": {"type": "object"},
    "capabilities_tools": {"type": "object"},
    "environment": {"type": "object"},
    "constraints": {"type": "object"},
    "hidden_fixtures": {"type": "object"},
    "authority_boundary": {"type": "object"},
    "acceptance_contract": {"type": "object"},
    "independent_evaluation": {"type": "object"},
    "required_evidence": {"type": "array", "minItems": 1},
    "terminal_outcome": {"type": "string", "enum": ["VERIFIED", "FAILED", "BLOCKED"], "description": "Provisional vocab; BLOCKED never counts as a model result."},
    "environment_identity": {"type": "string", "minLength": 1},
    "environment_start_state_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fixture_version": {"type": "string", "minLength": 1},
    "fixture_content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluator_ref": {"type": "string", "minLength": 1},
    "evaluator_version": {"type": "string", "minLength": 1},
    "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
